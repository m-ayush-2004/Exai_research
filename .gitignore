# Sensitive Information & Credentials
# These patterns broadly aim to prevent accidental inclusion of files that often contain sensitive data.

# Configuration files
.env               
# Environment variable files (e.g., .env, .env.local)
.env.*              
# Any environment variable file, including local and test versions
config.json         
# Generic configuration files (often contain secrets)
credentials.json    
# Files specifically named "credentials"
secrets.yml         
# YAML files likely containing secrets
config/secrets.yml  
# Ruby on Rails specific secrets file

# Key files and certificates
*.key               
# Private key files (e.g., SSH keys, API keys)
*.pem               
# Privacy Enhanced Mail files (often contain keys/certs)
*.p12               
# Personal Information Exchange files
*.pfx               
# Personal Information Exchange files
*.cer               
# Certificate files
*.crt               
# Certificate files
*.pub               
# Public key files (can be ignored if not intended for distribution)
id_rsa              
# SSH private key
id_dsa              
# SSH private key
id_ecdsa            
# SSH private key
id_ed25519          
# SSH private key

# Database related files
*.sql               
# SQL dump files (potentially contain sensitive data)
*.sqlite3           
# SQLite database files
*.db                
# Generic database files

# Log files
# Avoid committing log files, as they can sometimes contain sensitive information or stack traces revealing system details.
logs/               
# Ignore the entire 'logs' directory
*.log               
# All files ending with .log
npm-debug.log*      
# Node.js debug logs
yarn-debug.log*     
# Yarn debug logs
yarn-error.log*     
# Yarn error logs

# Temporary and backup files
# These files are often created by editors, IDEs, or system operations and don't belong in version control.
*.tmp               
# Temporary files
*.bak               
# Backup files
*~                  
# Files ending with a tilde (common backup format)
*.swp               
# Vim swap files
*.swo               
# Vim swap files
*.DS_Store          
# macOS specific metadata files
Thumbs.db           
# Windows thumbnail caches

# Build artifacts and compiled code
# These files are typically generated during the build process and should not be tracked.
**/target/          
# Maven target directories
**/build/           
# Generic build directories
**/dist/            
# Distribution directories
**/out/             
# Output directories
*.class             
# Java compiled files
*.jar               
# Java archive files
*.war               
# Web archive files
*.ear               
# Enterprise archive files
*.o                 
# Compiled object files
*.pyc               
# Python compiled bytecode files
__pycache__/        
# Python 3 bytecode cache directories
**/__pycache__/*    
# Python 3 bytecode cache directories

# Dependency management directories
# Do not commit installed dependencies; instead, track your dependency manifest files (e.g., package.json).
/node_modules/      
# Node.js dependencies
/vendor/            
# Composer (PHP) dependencies
/.venv/             
# Python virtual environments
venv/               
# Python virtual environments
.gradle/            
# Gradle files
/cmake-build-*/     
# CMake build directories

# IDE and editor specific files
# These files are typically specific to a developer's environment and shouldn't be shared.
.idea/              
# JetBrains IDE settings (IntelliJ, PyCharm, etc.)
*.iml               
# JetBrains IDE module files
.vscode/            
# Visual Studio Code settings
.project            
# Eclipse project files
.classpath          
# Eclipse classpath files

# Operating system specific files
# These files are generated by various operating systems and are generally not needed in the repository.
.DS_Store           
# macOS directory service store
Thumbs.db           
# Windows thumbnail cache
Desktop.ini         
# Windows desktop configuration file

# Recursive exclusion for sensitive files
# These patterns use double asterisks (**) to match files or directories at any level within the repository.
**/.env             
# Environment variable files anywhere
**/*.key            
# Private key files anywhere
**/*.pem            
# PEM files anywhere
**/id_rsa           
# SSH private key anywhere
**/secrets.json     
# Generic secrets files in JSON format anywhere
**/passwords.txt    
# Files explicitly named passwords.txt anywhere (should never exist)
**/credit_cards.txt 
# Files explicitly named credit_cards.txt anywhere (should never exist)

# Negating specific patterns
# Use "!" to include specific files or directories that would otherwise be ignored by a broader pattern.
# For example, if you have a logs directory that is ignored, but want to track a specific logs file:
# !logs/important.log  # This will track important.log even though 'logs/' is ignored (Note this only works for files, not files within ignored directories.)

# Git's performance quirk:  You cannot re-include a file if a parent directory of that file is excluded.
# For example, if you have the following in your .gitignore:
# logs/
# !logs/important.log
# The !logs/important.log rule will NOT work because the parent directory 'logs' is already ignored.

# Best practices to avoid information leaks beyond gitignore:
# - Use environment variables for sensitive data instead of hardcoding.
# - Implement secret management tools like HashiCorp Vault for handling secrets.
# - Utilize Git hooks (pre-commit, pre-push) to scan for sensitive information before committing or pushing.
# - Conduct regular security audits and code reviews.

